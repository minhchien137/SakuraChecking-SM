@model ScanCheckSakura.Models.CBCPLogViewModel
@{
    ViewData["Title"] = "检查历史 Inspection History";
}

<style>
    :root {
        --bg-primary:    #0f1217;
        --bg-secondary:  #1a1f27;
        --bg-tertiary:   #242a35;
        --text-primary:  #e2e8f0;
        --text-secondary:#94a3b8;
        --text-tertiary: #64748b;
        --border:        #2d3748;
        --accent:        #3b82f6;
        --pass-color:    #22c55e;
        --pass-bg:       rgba(34,197,94,0.12);
        --fail-color:    #ef4444;
        --fail-bg:       rgba(239,68,68,0.12);
        --radius:        10px;
    }

    body { background: var(--bg-primary); color: var(--text-primary); }

    .log-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2.5rem 2rem 4rem;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    }

    .log-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--border);
    }

    .log-header__left h1 { font-size: 1.6rem; font-weight: 600; margin: 0 0 0.3rem; }
    .log-header__left p  { font-size: 0.9rem; color: var(--text-secondary); margin: 0; }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 8px 16px;
        font-size: 0.875rem;
        font-weight: 500;
        background: var(--bg-tertiary);
        color: var(--text-secondary);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        text-decoration: none;
        transition: color 0.15s, border-color 0.15s;
    }

    .btn-back:hover { color: var(--text-primary); border-color: var(--text-tertiary); }

    /* ── Stat chips ─────────────────────────────────────── */
    .stat-row { display: flex; gap: 0.75rem; margin-bottom: 1.75rem; flex-wrap: wrap; }

    .stat-chip {
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 0.75rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 110px;
    }

    .stat-chip__val { font-size: 1.6rem; font-weight: 700; line-height: 1; }
    .stat-chip__lbl { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-tertiary); }

    /* ── Filter panel ───────────────────────────────────── */
    .filter-panel {
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
    }

    /* 6 cột cố định — tất cả nằm 1 hàng */
    .filter-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 140px 160px 160px auto;
        gap: 0.75rem 1rem;
        align-items: end;
    }

    @@media (max-width: 1100px) {
        .filter-grid { grid-template-columns: 1fr 1fr 1fr; }
    }

    @@media (max-width: 640px) {
        .filter-grid { grid-template-columns: 1fr; }
    }

    .filter-group { display: flex; flex-direction: column; gap: 5px; }

    .filter-group label {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--text-tertiary);
    }

    .filter-group input,
    .filter-group select {
        padding: 0 11px;
        font-size: 0.875rem;
        font-family: inherit;
        background: var(--bg-tertiary);
        border: 1px solid var(--border);
        border-radius: 7px;
        color: var(--text-primary);
        outline: none;
        transition: border-color 0.2s;
        width: 100%;
        height: 36px;
    }

    .filter-group input:focus,
    .filter-group select:focus { border-color: var(--accent); }

    .filter-group select option { background: var(--bg-tertiary); }

    .filter-actions {
        display: flex;
        gap: 0.5rem;
        align-items: flex-end;
    }

    .btn-filter {
        padding: 0 18px;
        font-size: 0.875rem;
        font-weight: 600;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 7px;
        cursor: pointer;
        transition: background 0.15s;
        height: 36px;
        white-space: nowrap;
    }

    .btn-filter:hover { background: #2563eb; }

    .btn-reset-filter {
        padding: 0 14px;
        font-size: 0.875rem;
        font-weight: 500;
        background: transparent;
        color: var(--text-secondary);
        border: 1px solid var(--border);
        border-radius: 7px;
        height: 36px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: color 0.15s, border-color 0.15s;
        white-space: nowrap;
    }

    .btn-reset-filter:hover { color: var(--text-primary); border-color: var(--text-tertiary); }

    .btn-excel {
        padding: 0 14px;
        font-size: 0.875rem;
        font-weight: 600;
        background: #166534;
        color: #bbf7d0;
        border: 1px solid #15803d;
        border-radius: 7px;
        height: 36px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: background 0.15s;
        white-space: nowrap;
    }

    .btn-excel:hover { background: #15803d; color: #bbf7d0; }

    /* ── Table ──────────────────────────────────────────── */
    .table-card {
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
    }

    .table-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.9rem 1.25rem;
        border-bottom: 1px solid var(--border);
    }

    .table-toolbar__info { font-size: 0.82rem; color: var(--text-tertiary); }

    .table-scroll {
        overflow-x: auto;
        overflow-y: auto;
        max-height: calc(100vh - 420px);
        min-height: 300px;
        scrollbar-width: thin;
        scrollbar-color: var(--bg-tertiary) transparent;
    }

    .table-scroll::-webkit-scrollbar       { width: 5px; height: 5px; }
    .table-scroll::-webkit-scrollbar-track { background: transparent; }
    .table-scroll::-webkit-scrollbar-thumb { background: var(--bg-tertiary); border-radius: 4px; }

    .log-table { width: 100%; border-collapse: collapse; font-size: 0.855rem; }

    .log-table thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: var(--bg-tertiary);
        padding: 10px 14px;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
        text-align: left;
    }

    .log-table tbody tr { border-bottom: 1px solid rgba(45,55,72,0.5); transition: background 0.1s; }
    .log-table tbody tr:last-child { border-bottom: none; }
    .log-table tbody tr:hover { background: rgba(255,255,255,0.025); }

    .log-table td { padding: 9px 14px; color: var(--text-primary); vertical-align: middle; white-space: nowrap; }

    .td-mono { font-family: 'Courier New', monospace; font-size: 0.82rem; }
    .td-time { font-size: 0.8rem; color: var(--text-tertiary); }
    .td-note { max-width: 240px; overflow: hidden; text-overflow: ellipsis; font-size: 0.78rem; color: var(--text-tertiary); }

    .dot-sm { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px; vertical-align: middle; }

    .pill { display: inline-block; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; padding: 2px 10px; border-radius: 20px; }
    .pill-pass { background: var(--pass-bg); color: var(--pass-color); }
    .pill-fail { background: var(--fail-bg); color: var(--fail-color); }

    .table-empty { padding: 3rem; text-align: center; color: var(--text-tertiary); font-size: 0.9rem; }

    /* ── Pagination ─────────────────────────────────────── */
    .pagination { display: flex; align-items: center; justify-content: center; gap: 4px; padding: 1rem 1.25rem; border-top: 1px solid var(--border); flex-wrap: wrap; }

    .page-btn {
        padding: 5px 11px;
        font-size: 0.82rem;
        font-weight: 500;
        background: var(--bg-tertiary);
        color: var(--text-secondary);
        border: 1px solid var(--border);
        border-radius: 6px;
        text-decoration: none;
        transition: background 0.1s, color 0.1s;
        min-width: 34px;
        text-align: center;
    }

    .page-btn:hover  { background: var(--accent); color: #fff; border-color: var(--accent); }
    .page-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }
    .page-btn.disabled { opacity: 0.35; pointer-events: none; }
</style>

<div class="log-wrap">

    <!-- Header -->
    <div class="log-header">
        <div class="log-header__left">
            <h1>检查历史 Inspection History</h1>
            <p>所有色盒与产品盒检查结果 All Color Box & Product Box Check Results</p>
        </div>
        <a asp-action="CBCP" asp-controller="FGCheck" class="btn-back">← 返回检查 Back to Check</a>
    </div>

    <!-- Stat chips -->
    <div class="stat-row">
        <div class="stat-chip">
            <span class="stat-chip__val" style="color:var(--text-primary)">@Model.TotalCount</span>
            <span class="stat-chip__lbl">总数 TOTAL</span>
        </div>
        <div class="stat-chip">
            <span class="stat-chip__val" style="color:var(--pass-color)">@Model.PassCount</span>
            <span class="stat-chip__lbl">通过 PASS</span>
        </div>
        <div class="stat-chip">
            <span class="stat-chip__val" style="color:var(--fail-color)">@Model.FailCount</span>
            <span class="stat-chip__lbl">失败 FAIL</span>
        </div>
        <div class="stat-chip">
            <span class="stat-chip__val" style="color:var(--accent)">
                @(Model.TotalCount > 0 ? Math.Round((double)Model.PassCount / Model.TotalCount * 100, 1) : 0)%
            </span>
            <span class="stat-chip__lbl">通过率 PASS RATE</span>
        </div>
    </div>

    <!-- Filter -->
    <div class="filter-panel">
        <form asp-action="CBCPLog" asp-controller="FGCheck" method="get">
            <div class="filter-grid">

                <div class="filter-group">
                    <label>色盒序列号 Color Box SN</label>
                    <input type="text" name="BoxSN" value="@Model.Filter.BoxSN" placeholder="搜索色盒序列号 Search box SN..." />
                </div>

                <div class="filter-group">
                    <label>产品序列号 Product SN</label>
                    <input type="text" name="ProductSN" value="@Model.Filter.ProductSN" placeholder="搜索产品序列号 Search product SN..." />
                </div>

                <div class="filter-group">
                    <label>结果 Result</label>
                    <select name="Result">
                        <option value=""     selected="@(string.IsNullOrEmpty(Model.Filter.Result) ? "selected" : null)">-- 全部 All --</option>
                        <option value="PASS" selected="@(Model.Filter.Result == "PASS" ? "selected" : null)">通过 PASS</option>
                        <option value="FAIL" selected="@(Model.Filter.Result == "FAIL" ? "selected" : null)">失败 FAIL</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label>开始日期 From Date</label>
                    <input type="date" name="DateFrom" value="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")" />
                </div>

                <div class="filter-group">
                    <label>结束日期 To Date</label>
                    <input type="date" name="DateTo" value="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")" />
                </div>

                <input type="hidden" name="Page"     value="1" />
                <input type="hidden" name="PageSize" value="@Model.Filter.PageSize" />

                <div class="filter-actions">
                    <button type="submit" class="btn-filter">筛选 Filter</button>
                    <a asp-action="CBCPLog" asp-controller="FGCheck" class="btn-reset-filter">重置 Reset</a>
                    <a asp-action="CBCPLogExport" asp-controller="FGCheck"
                       asp-route-BoxSN="@Model.Filter.BoxSN"
                       asp-route-ProductSN="@Model.Filter.ProductSN"
                       asp-route-Result="@Model.Filter.Result"
                       asp-route-DateFrom="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")"
                       asp-route-DateTo="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")"
                       class="btn-excel">↓ 导出 Excel Export</a>
                </div>

            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="table-card">

        <div class="table-toolbar">
            <span class="table-toolbar__info">
                显示 Showing
                @((Model.CurrentPage - 1) * Model.Filter.PageSize + 1)–@Math.Min(Model.CurrentPage * Model.Filter.PageSize, Model.TotalCount)
                / @Model.TotalCount 条记录 records
            </span>
        </div>

        <div class="table-scroll">
            @if (!Model.Logs.Any())
            {
                <div class="table-empty">未找到记录 No records found</div>
            }
            else
            {
                <table class="log-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>时间 TIME</th>
                            <th>色盒序列号 COLOR BOX SN</th>
                            <th>产品序列号 PRODUCT SN</th>
                            <th>色盒颜色 BOX COLOR</th>
                            <th>产品颜色 PRODUCT COLOR</th>
                            <th>结果 RESULT</th>
                            <th>备注 NOTE</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowNum = (Model.CurrentPage - 1) * Model.Filter.PageSize + 1; }
                        @foreach (var log in Model.Logs)
                        {
                            string dotBox = log.BoxColor switch
                            {
                                "Pink"  => "#ec4899",
                                "Blue"  => "#3b82f6",
                                "Green" => "#22c55e",
                                _       => "#64748b"
                            };
                            string dotProd = log.ProductColor switch
                            {
                                "Pink"  => "#ec4899",
                                "Blue"  => "#3b82f6",
                                "Green" => "#22c55e",
                                _       => "#64748b"
                            };
                            <tr>
                                <td style="color:var(--text-tertiary); font-size:0.78rem;">@rowNum</td>
                                <td class="td-time">@log.CheckedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td class="td-mono">@log.BoxSN</td>
                                <td class="td-mono">@log.ProductSN</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(log.BoxColor))
                                    { <span class="dot-sm" style="background:@dotBox"></span>@log.BoxColor }
                                    else
                                    { <span style="color:var(--text-tertiary)">—</span> }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(log.ProductColor))
                                    { <span class="dot-sm" style="background:@dotProd"></span>@log.ProductColor }
                                    else
                                    { <span style="color:var(--text-tertiary)">—</span> }
                                </td>
                                <td>
                                    <span class="pill @(log.Result == "PASS" ? "pill-pass" : "pill-fail")">@log.Result</span>
                                </td>
                                <td class="td-note" title="@log.ErrorMessage">
                                    @(string.IsNullOrEmpty(log.ErrorMessage) ? "—" : log.ErrorMessage)
                                </td>
                            </tr>
                            rowNum++;
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="pagination">
                <a class="page-btn @(Model.CurrentPage <= 1 ? "disabled" : "")"
                   asp-action="CBCPLog" asp-controller="FGCheck"
                   asp-route-Page="@(Model.CurrentPage - 1)"
                   asp-route-PageSize="@Model.Filter.PageSize"
                   asp-route-BoxSN="@Model.Filter.BoxSN"
                   asp-route-ProductSN="@Model.Filter.ProductSN"
                   asp-route-Result="@Model.Filter.Result"
                   asp-route-DateFrom="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")"
                   asp-route-DateTo="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")">←</a>

                @for (int p = Math.Max(1, Model.CurrentPage - 2);
                          p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
                {
                    <a class="page-btn @(p == Model.CurrentPage ? "active" : "")"
                       asp-action="CBCPLog" asp-controller="FGCheck"
                       asp-route-Page="@p"
                       asp-route-PageSize="@Model.Filter.PageSize"
                       asp-route-BoxSN="@Model.Filter.BoxSN"
                       asp-route-ProductSN="@Model.Filter.ProductSN"
                       asp-route-Result="@Model.Filter.Result"
                       asp-route-DateFrom="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")"
                       asp-route-DateTo="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")">@p</a>
                }

                <a class="page-btn @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                   asp-action="CBCPLog" asp-controller="FGCheck"
                   asp-route-Page="@(Model.CurrentPage + 1)"
                   asp-route-PageSize="@Model.Filter.PageSize"
                   asp-route-BoxSN="@Model.Filter.BoxSN"
                   asp-route-ProductSN="@Model.Filter.ProductSN"
                   asp-route-Result="@Model.Filter.Result"
                   asp-route-DateFrom="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")"
                   asp-route-DateTo="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")">→</a>
            </div>
        }

    </div>
</div>